.lab-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(245,245,232); }
.lab-toggle { width: 280px; font-size: 14px; -unity-text-align: middle-center; border-width: 1px; border-color: rgb(31,199,255); border-radius: 6px; position: absolute; right: 28px; top: 28px; height: 36px; background-color: rgb(24,27,59); color: rgb(245,245,232); }
.lab-controls { position: absolute; right: 28px; top: 74px; width: 410px; max-height: 720px; padding: 18px; background-color: rgba(11,14,36,0.97); border-width: 2px; border-color: rgb(31,199,255); border-radius: 12px; }
.lab-heading { font-size: 18px; -unity-font-style: bold; white-space: normal; margin-bottom: 8px; }
.lab-note { font-size: 15px; white-space: normal; margin-top: 6px; margin-bottom: 8px; }
.lab-row { flex-direction: row; }
.lab-controls Button { height: 36px; margin: 3px; flex-grow: 1; background-color: rgb(24,27,59); color: rgb(245,245,232); }
.lab-controls Button:hover { background-color: rgb(49,73,104); }
.lab-controls DropdownField { margin-top: 8px; margin-bottom: 8px; }
.lab-hidden { display: none; }

.lab-controls Button { -unity-text-align: middle-center; font-size: 15px; border-width: 1px; border-color: rgb(56,83,112); border-radius: 5px; }
.lab-controls .unity-base-field { flex-direction: row; align-items: center; }
.lab-controls .unity-base-field__label { min-width: 90px; width: 90px; margin-right: 8px; }
.lab-controls .unity-base-field__input { flex-grow: 1; padding: 10px; background-color: rgb(24,27,59); border-width: 1px; border-color: rgb(56,83,112); border-radius: 5px; }
